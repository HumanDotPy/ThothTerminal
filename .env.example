# Core local runtime
THOTH_MODE=local_desktop
THOTH_HOST=127.0.0.1
THOTH_PORT=8750
THOTH_DATABASE_URL=postgresql+psycopg://thoth:change-me@127.0.0.1:55432/thoth
THOTH_MCP_TOOL_PROFILE=full
THOTH_CHATGPT_APP_TOOL_PROFILE=research_desk_v1

# Optional model provider
THOTH_AI_PROVIDER=local
THOTH_AGENT_LLM_ENDPOINT=http://127.0.0.1:8080/v1
THOTH_AGENT_LLM_MODEL=your-local-model

# Optional public research surface
THOTH_PUBLIC_BASE_URL=https://thoth.example.com
THOTH_PUBLIC_BASE_URL_RESTRICT_TO_PUBLIC_ROUTES=true

# Optional heartbeat newsletter
THOTH_NEWSLETTER_ENABLED=false
THOTH_NEWSLETTER_PUBLIC_BASE_URL=https://thoth.example.com
THOTH_NEWSLETTER_FROM_EMAIL=Thoth Research <newsletter@example.com>
THOTH_NEWSLETTER_SIGNING_SECRET=replace-with-at-least-32-random-characters
THOTH_NEWSLETTER_SMTP_HOST=smtp.example.com
THOTH_NEWSLETTER_SMTP_PORT=587
THOTH_NEWSLETTER_SMTP_USERNAME=
THOTH_NEWSLETTER_SMTP_PASSWORD=
THOTH_NEWSLETTER_SMTP_STARTTLS=true
